# Токен Kodik API используется ТОЛЬКО в serverless-функциях (папка /api),
# на клиенте (assets/scripts/index.js) токена больше нет.
#
# Локально: скопируйте этот файл в .env и подставьте свой токен —
# `vercel dev` подхватит его автоматически.
# На проде: Vercel → Project Settings → Environment Variables → KODIK_API_TOKEN
KODIK_API_TOKEN=your_token_here
