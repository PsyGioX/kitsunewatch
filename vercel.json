{
    "version": 2,
    "builds": [
        {
            "src": "api/config.js",
            "use": "@vercel/node"
        },
        {
            "src": "**/*.{html,css,js,json,png,ico,webmanifest,svg}",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/api/$1"
        },
        {
            "src": "/sw.js",
            "headers": {
                "Cache-Control": "no-cache"
            },
            "dest": "/sw.js"
        },
        {
            "src": "/(.*)",
            "dest": "/$1"
        }
    ]
}