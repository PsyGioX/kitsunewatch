{
    "version": 2,
    "builds": [
        {
            "src": "api/config.js",
            "use": "@vercel/node"
        },
        {
            "src": "**/*.{html,css,js,json,png,ico,webmanifest}",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/api/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/$1"
        }
    ]
}