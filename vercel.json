{
    "version": 2,
    "builds": [
        {
            "src": "api/**/*.js",
            "use": "@vercel/node"
        },
        {
            "src": "**/*.{html,css,js,json,svg,png,ico,webmanifest,jpg,jpeg,txt,xml}",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/api/$1"
        },
        {
            "handle": "filesystem"
        },
        {
            "src": "/.*",
            "dest": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/assets/(.*)",
            "headers": [
                { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
            ]
        },
        {
            "source": "/imgs/(.*)",
            "headers": [
                { "key": "Cache-Control", "value": "public, max-age=604800, immutable" }
            ]
        },
        {
            "source": "/(.*)\\.(?:png|jpg|jpeg|ico|svg)",
            "headers": [
                { "key": "Cache-Control", "value": "public, max-age=604800, immutable" }
            ]
        },
        {
            "source": "/sw.js",
            "headers": [
                { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
            ]
        }
    ]
}
