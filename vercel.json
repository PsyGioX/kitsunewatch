{
    "version": 2,
    "functions": {
        "api/*.js": {
            "maxDuration": 10
        }
    },
    "routes": [
        {
            "src": "/api/search",
            "dest": "/api/search.js"
        },
        {
            "src": "/api/config",
            "dest": "/api/config.js"
        },
        {
            "src": "/sw.js",
            "headers": {
                "Cache-Control": "no-cache"
            },
            "continue": true
        },
        {
            "handle": "filesystem"
        },
        {
            "src": "/(.*)",
            "dest": "/$1"
        }
    ]
}