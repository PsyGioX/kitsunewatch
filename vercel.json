{
    "version": 2,
    "builds": [
        {
            "src": "api/**/*.js",
            "use": "@vercel/node"
        },
        {
            "src": "**/*.{html,css,js,json,svg,png,ico,webmanifest,jpg,jpeg}",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/api/$1"
        },
        {
            "src": "/sw.js",
            "headers": {
                "Cache-Control": "no-cache"
            },
            "continue": true
        },
        {
            "src": "/imgs/(.*)",
            "dest": "/imgs/$1"
        },
        {
            "src": "/assets/(.*)",
            "dest": "/assets/$1"
        },
        {
            "handle": "filesystem"
        },
        {
            "src": "/.*",
            "dest": "/index.html"
        }
    ]
}